# ─────────────────────────────────────────────
#  Islamic App API — Environment Configuration
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Default Prayer Location (Sanaa, Yemen)
DEFAULT_LATITUDE=15.3694
DEFAULT_LONGITUDE=44.1910

# Default Calculation Method (MuslimWorldLeague = 3, MoonsightingCommittee = 5, etc.)
DEFAULT_CALCULATION_METHOD=MuslimWorldLeague

# CORS — comma-separated allowed origins (* for all)
ALLOWED_ORIGINS=*
